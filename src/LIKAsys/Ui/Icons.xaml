    <GeometryGroup x:Key="IconUptimeApple" FillRule="EvenOdd">
        <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" />
        <PathGeometry Figures="M12,6.8 L12,12.2 L15.6,14" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconFpsApple" FillRule="EvenOdd">
        <PathGeometry Figures="M3.6,16.8 A9,9 0 0 1 20.4,16.8" />
        <LineGeometry StartPoint="12,16.4" EndPoint="16.4,10.8" />
    </GeometryGroup>

    <!-- ================= storage + uptime (shared) ================= -->

    <!-- disk: platters seen from the side -->
    <GeometryGroup x:Key="IconDisk" FillRule="EvenOdd">
        <PathGeometry Figures="M3.6,6.6 A8.4,2.8 0 1 1 20.4,6.6 A8.4,2.8 0 1 1 3.6,6.6" />
        <PathGeometry Figures="M3.6,6.6 L3.6,17.4 A8.4,2.8 0 0 0 20.4,17.4 L20.4,6.6" />
        <PathGeometry Figures="M3.6,12 A8.4,2.8 0 0 0 20.4,12" />
    </GeometryGroup>

    <!-- disk throughput: platters with read/write arrows -->
    <GeometryGroup x:Key="IconDiskIo" FillRule="EvenOdd">
        <PathGeometry Figures="M2.6,6 A6.6,2.4 0 1 1 15.8,6 A6.6,2.4 0 1 1 2.6,6" />
        <PathGeometry Figures="M2.6,6 L2.6,15 A6.6,2.4 0 0 0 15.8,15 L15.8,6" />
        <PathGeometry Figures="M19.4,8.4 L19.4,20.2" />
        <PathGeometry Figures="M16.4,17.4 L19.4,20.6 L22.4,17.4" />
    </GeometryGroup>

    <!-- uptime: a clock with a sweep -->
    <GeometryGroup x:Key="IconUptime" FillRule="EvenOdd">
        <EllipseGeometry Center="12,12" RadiusX="8.8" RadiusY="8.8" />
        <PathGeometry Figures="M12,7 L12,12.4 L15.8,14.6" />
    </GeometryGroup>

    <!-- ================= IT profile: flat, technical set ================= -->

    <!-- processor: a plain square die with contacts -->
    <GeometryGroup x:Key="IconCpuIt" FillRule="EvenOdd">
        <RectangleGeometry Rect="5,5 14,14" />
        <RectangleGeometry Rect="9,9 6,6" />
        <LineGeometry StartPoint="8,5" EndPoint="8,2.4" />
        <LineGeometry StartPoint="12,5" EndPoint="12,2.4" />
        <LineGeometry StartPoint="16,5" EndPoint="16,2.4" />
        <LineGeometry StartPoint="8,19" EndPoint="8,21.6" />
        <LineGeometry StartPoint="12,19" EndPoint="12,21.6" />
        <LineGeometry StartPoint="16,19" EndPoint="16,21.6" />
        <LineGeometry StartPoint="5,8" EndPoint="2.4,8" />
        <LineGeometry StartPoint="5,12" EndPoint="2.4,12" />
        <LineGeometry StartPoint="5,16" EndPoint="2.4,16" />
        <LineGeometry StartPoint="19,8" EndPoint="21.6,8" />
        <LineGeometry StartPoint="19,12" EndPoint="21.6,12" />
        <LineGeometry StartPoint="19,16" EndPoint="21.6,16" />
    </GeometryGroup>

    <!-- graphics: an expansion card with a bracket -->
    <GeometryGroup x:Key="IconGpuIt" FillRule="EvenOdd">
        <RectangleGeometry Rect="3,6 16,12" />
        <RectangleGeometry Rect="19,4.4 2,15.2" />
        <LineGeometry StartPoint="6,9.4" EndPoint="15.4,9.4" />
        <LineGeometry StartPoint="6,12" EndPoint="15.4,12" />
        <LineGeometry StartPoint="6,14.6" EndPoint="11.6,14.6" />
    </GeometryGroup>

    <!-- memory: a module seen flat on -->
    <GeometryGroup x:Key="IconRamIt" FillRule="EvenOdd">
        <RectangleGeometry Rect="2.4,6.4 19.2,11.2" />
        <LineGeometry StartPoint="7.2,6.4" EndPoint="7.2,17.6" />
        <LineGeometry StartPoint="12,6.4" EndPoint="12,17.6" />
        <LineGeometry StartPoint="16.8,6.4" EndPoint="16.8,17.6" />
    </GeometryGroup>

    <!-- network: a switch with two ports -->
    <GeometryGroup x:Key="IconNetIt" FillRule="EvenOdd">
        <RectangleGeometry Rect="2.4,13.6 19.2,6.4" />
        <LineGeometry StartPoint="6.4,16.8" EndPoint="9.2,16.8" />
        <LineGeometry StartPoint="12,16.8" EndPoint="14.8,16.8" />
        <PathGeometry Figures="M12,13.6 L12,8.4" />
        <PathGeometry Figures="M6.4,8.4 L17.6,8.4" />
        <PathGeometry Figures="M6.4,8.4 L6.4,4.8" />
        <PathGeometry Figures="M17.6,8.4 L17.6,4.8" />
    </GeometryGroup>

    <!-- storage: a drive bay in a rack, with status lamps -->
    <GeometryGroup x:Key="IconDiskIt" FillRule="EvenOdd">
        <RectangleGeometry Rect="2.4,4.8 19.2,14.4" />
        <LineGeometry StartPoint="2.4,12" EndPoint="21.6,12" />
        <LineGeometry StartPoint="6,8.4" EndPoint="13.2,8.4" />
        <LineGeometry StartPoint="6,15.6" EndPoint="13.2,15.6" />
        <RectangleGeometry Rect="17.2,7.6 1.6,1.6" />
        <RectangleGeometry Rect="17.2,14.8 1.6,1.6" />
    </GeometryGroup>

    <!-- throughput: read up, write down, inside the box -->
    <GeometryGroup x:Key="IconDiskIoIt" FillRule="EvenOdd">
        <RectangleGeometry Rect="2.8,2.8 18.4,18.4" />
        <PathGeometry Figures="M8.4,16.8 L8.4,7.2" />
        <PathGeometry Figures="M5.6,10 L8.4,7.2 L11.2,10" />
        <PathGeometry Figures="M15.6,7.2 L15.6,16.8" />
        <PathGeometry Figures="M12.8,14 L15.6,16.8 L18.4,14" />
    </GeometryGroup>

    <!-- uptime: a square clock, no curves anywhere in this family -->
    <GeometryGroup x:Key="IconUptimeIt" FillRule="EvenOdd">
        <RectangleGeometry Rect="3.2,3.2 17.6,17.6" />
        <PathGeometry Figures="M12,7.2 L12,12 L16,14.4" />
        <LineGeometry StartPoint="12,3.2" EndPoint="12,5.2" />
        <LineGeometry StartPoint="12,18.8" EndPoint="12,20.8" />
        <LineGeometry StartPoint="3.2,12" EndPoint="5.2,12" />
        <LineGeometry StartPoint="18.8,12" EndPoint="20.8,12" />
    </GeometryGroup>

    <!-- frames per second: a plotted trace on a screen -->
    <GeometryGroup x:Key="IconFpsIt" FillRule="EvenOdd">
        <RectangleGeometry Rect="2.8,4 18.4,13.2" />
        <LineGeometry StartPoint="2.8,20.4" EndPoint="21.2,20.4" />
        <PathGeometry Figures="M5.6,14 L9.2,9.6 L12.8,12.4 L18.4,6.8" />
    </GeometryGroup>

    <!-- the one percent low: the dip in the trace, marked -->
    <GeometryGroup x:Key="IconLowIt" FillRule="EvenOdd">
        <PathGeometry Figures="M2.8,6.4 L8,6.4 L11.6,17.2 L15.2,10.4 L21.2,10.4" />
        <LineGeometry StartPoint="11.6,17.2" EndPoint="11.6,21.2" />
        <LineGeometry StartPoint="9.2,20.4" EndPoint="14,20.4" />
    </GeometryGroup>

    <!-- frame time: three frames side by side -->
    <GeometryGroup x:Key="IconFrameIt" FillRule="EvenOdd">
        <RectangleGeometry Rect="2.8,5.2 18.4,13.6" />
        <LineGeometry StartPoint="7.6,5.2" EndPoint="7.6,18.8" />
        <LineGeometry StartPoint="16.4,5.2" EndPoint="16.4,18.8" />
        <LineGeometry StartPoint="7.6,12" EndPoint="16.4,12" />
    </GeometryGroup>

    <!-- latency: a signal mast -->
    <GeometryGroup x:Key="IconPingIt" FillRule="EvenOdd">
        <PathGeometry Figures="M12,9.2 L12,20.4" />
        <PathGeometry Figures="M8.4,20.4 L15.6,20.4" />
        <PathGeometry Figures="M7.4,8.2 A6.6,6.6 0 0 1 16.6,8.2" />
        <PathGeometry Figures="M4.2,5.4 A11,11 0 0 1 19.8,5.4" />
        <EllipseGeometry Center="12,11.2" RadiusX="1.4" RadiusY="1.4" />
    </GeometryGroup>

    <!-- 1% low: a frame-time graph with one deep dip -->
    <GeometryGroup x:Key="IconLow" FillRule="EvenOdd">
        <PathGeometry Figures="M3,8.4 L6.6,8.4 L8.4,18.6 L10.2,8.4 L13.8,8.4 L15.6,14.4 L17.4,8.4 L21,8.4" />
        <PathGeometry Figures="M3,21 L21,21" />
    </GeometryGroup>

    <!-- frame time: a frame with a timing tick -->
    <GeometryGroup x:Key="IconFrame" FillRule="EvenOdd">
        <RectangleGeometry Rect="3,5 18,14" RadiusX="2.4" RadiusY="2.4" />
        <PathGeometry Figures="M12,8.6 L12,12 L14.6,13.6" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconNet" FillRule="EvenOdd">
        <PathGeometry Figures="M7.2,3.6 L7.2,16.4" />
        <PathGeometry Figures="M3.4,12.8 L7.2,16.8 L11,12.8" />
        <PathGeometry Figures="M16.8,20.4 L16.8,7.6" />
        <PathGeometry Figures="M13,11.2 L16.8,7.2 L20.6,11.2" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconPing" FillRule="EvenOdd">
        <PathGeometry Figures="M3.6,11.4 A11.2,11.2 0 0 1 20.4,11.4" />
        <PathGeometry Figures="M7.4,14.8 A6.4,6.4 0 0 1 16.6,14.8" />
        <EllipseGeometry Center="12,19" RadiusX="1.5" RadiusY="1.5" />
    </GeometryGroup>

