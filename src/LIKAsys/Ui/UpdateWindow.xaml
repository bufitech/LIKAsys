<Window x:Class="LIKAsys.Ui.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIKAsys - Perditesim" Width="560" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI" UseLayoutRounding="True">

    <Grid Margin="14">
        <Border CornerRadius="16" Background="#FF0A0D14" BorderBrush="#26FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.7" Color="Black" />
            </Border.Effect>

            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- head -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Title_Drag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="#FF131A26"
                            BorderBrush="#2600E5FF" BorderThickness="1" Margin="0,0,14,0">
                        <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource Accent}" StrokeThickness="1.7"
                              Width="20" Height="20" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadLine" Style="{StaticResource H1}" Text="Version i ri i disponueshem" />
                        <TextBlock x:Name="SubLine" Style="{StaticResource Caption}" Margin="0,2,0,0" Text="" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" Click="Close_Click">
                        <Path Data="{StaticResource IconClose}" Stroke="#FF93A6BE" StrokeThickness="1.7"
                              Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Style="{StaticResource H2}" Text="ÇFARE KA TE RE" Margin="0,22,0,8" />

                <Border Grid.Row="2" Background="#FF0E131D" CornerRadius="10" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <TextBlock x:Name="NotesText" Foreground="#FFBFD0E6" FontSize="12.5" TextWrapping="Wrap"
                                   LineHeight="19" Text="-" />
                    </ScrollViewer>
                </Border>

                <!-- progress -->
                <StackPanel Grid.Row="3" x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <Grid Height="6">
                        <Border CornerRadius="3" Background="#FF1B2433" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FillCol" Width="0*" />
                                <ColumnDefinition x:Name="RestCol" Width="100*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="3" Background="{DynamicResource Accent}" />
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Duke shkarkuar..." />
                </StackPanel>

                <!-- buttons -->
                <Grid Grid.Row="4" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="Auto" Height="Auto"
                            HorizontalAlignment="Left" Click="Site_Click" Padding="6,4">
                        <TextBlock Text="Likaapps.com" FontSize="11.5" Foreground="#FF5D6E85" />
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="LaterBtn" Style="{StaticResource GhostButton}" Content="Me vone" Click="Close_Click" Margin="0,0,10,0" />
                        <Button x:Name="InstallBtn" Style="{StaticResource AccentButton}" Content="Instalo tani" Click="Install_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
