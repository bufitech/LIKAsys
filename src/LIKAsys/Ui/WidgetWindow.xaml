<Window x:Class="LIKAsys.Ui.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LIKAsys.Ui"
        Title="LIKAsys" WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" Left="-6000" Top="-6000" ShowActivated="False" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI"
        PreviewMouseWheel="Widget_Wheel" MouseEnter="Widget_Enter" MouseLeave="Widget_Leave">

    <Window.Resources>
        <ui:StarConverter x:Key="Star" />

        <DataTemplate x:Key="RowTemplate">
          <Border Background="{Binding CapsuleBg}" BorderBrush="{Binding CapsuleBorder}"
                  BorderThickness="{Binding CapsuleThickness}" CornerRadius="{Binding CapsuleRadius}"
                  Padding="{Binding CapsulePad}" Effect="{Binding CapsuleEffect}"
                  Margin="{Binding RowMargin}" Opacity="{Binding RowOpacity}">
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding RowShift}" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- icon, optionally inside its own tile -->
                <Border Grid.Column="0" Background="{Binding TileBg}" CornerRadius="{Binding TileRadius}"
                        Padding="{Binding TilePad}" Margin="0,0,9,0" VerticalAlignment="Center"
                        Visibility="{Binding IconVisibility}">
                <Viewbox Width="{Binding IconBox}" Height="{Binding IconBox}">
                    <Grid Width="24" Height="24">
                        <Path Data="{Binding Icon}" Stroke="{Binding IconShadowBrush}"
                              StrokeThickness="{Binding IconThickness}" Visibility="{Binding ShadowVisibility}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                            <Path.RenderTransform>
                                <TranslateTransform X="1.1" Y="1.4" />
                            </Path.RenderTransform>
                        </Path>
                        <Path Data="{Binding Icon}" Stroke="{Binding IconStroke}" Fill="{Binding IconFill}"
                              StrokeThickness="{Binding IconThickness}" Effect="{Binding IconEffect}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Grid>
                </Viewbox>
                </Border>

                <!-- label + bar -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" FontSize="{Binding LabelSize}"
                                   Foreground="{Binding LabelBrush}" FontWeight="{Binding LabelWeight}" />
                        <TextBlock Text="{Binding Detail}" FontSize="{Binding DetailSize}" Margin="7,0,0,0"
                                   Foreground="{Binding DetailBrush}" Visibility="{Binding DetailVisibility}"
                                   VerticalAlignment="Center" Width="{Binding DetailWidth}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <Grid Height="{Binding BarHeight}" Margin="0,5,0,0" MinWidth="74"
                          Visibility="{Binding BarVisibility}" OpacityMask="{Binding BarMask}">
                        <Border CornerRadius="{Binding BarRadius}" Background="{Binding TrackBrush}" />
                        <Border CornerRadius="{Binding BarRadius}" Background="{Binding BarBrush}"
                                HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Fill}" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- value -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Value}" FontSize="{Binding ValueSize}" FontWeight="{Binding ValueWeight}"
                               Foreground="{Binding ValueBrush}" Width="{Binding ValueWidth}"
                               TextAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="{Binding Unit}" FontSize="{Binding UnitSize}" Foreground="{Binding UnitBrush}"
                               Visibility="{Binding UnitVisibility}" Margin="3,0,0,1" VerticalAlignment="Bottom" />
                </StackPanel>

                <!-- the last readings, drawn small -->
                <Path Grid.Column="3" Data="{Binding Spark}" Stroke="{Binding SparkBrush}" StrokeThickness="1.4"
                      Width="{Binding SparkWidth}" Height="{Binding SparkHeight}" Margin="10,0,0,0"
                      Visibility="{Binding SparkVisibility}" VerticalAlignment="Center"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      SnapsToDevicePixels="True" />
            </Grid>
          </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="VerticalPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid x:Name="ScaleHost" Margin="14">
        <Border x:Name="Card" CornerRadius="14" BorderThickness="1" Padding="13,10,13,9" MinWidth="150">
            <StackPanel x:Name="CardContent">
                <!-- match strip (CS2): built in code, one flat row, nothing else showing -->
                <StackPanel x:Name="MatchHost" Orientation="Horizontal" Visibility="Collapsed" />

                <!-- header -->
                <Grid x:Name="HeaderRow" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="BrandDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="1,0,7,0">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="DotGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.9" Color="#FF00E5FF" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="BrandText" Text="LIKAsys" FontSize="11" FontWeight="Bold"
                                   Foreground="#FFEAF2FF" VerticalAlignment="Center" />
                        <TextBlock x:Name="MiniLine" FontSize="11" Margin="10,0,6,0" Visibility="Collapsed"
                                   Foreground="#FFBFD0E6" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />

                    </StackPanel>

                    <!-- The pill content. The name sits on the left and the number on the
                         right, with the gap between them, the way the iPhone puts things
                         either side of the camera. Two layers take turns so one reading can
                         rise away while the next one comes up into the same spot. -->
                    <Grid x:Name="IslandSwap" Grid.Column="1" Visibility="Collapsed" Height="17"
                          VerticalAlignment="Center" Margin="8,0,2,0" ClipToBounds="True">
                        <Grid x:Name="IsleA">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="IsleAT" />
                            </Grid.RenderTransform>
                            <TextBlock x:Name="IsleAL" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       FontSize="11.5" FontWeight="SemiBold" TextWrapping="NoWrap"
                                       Foreground="#FF9A9AA0" />
                            <TextBlock x:Name="IsleAR" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="NoWrap"
                                       Foreground="#FFFFFFFF" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <Grid x:Name="IsleB" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="IsleBT" />
                            </Grid.RenderTransform>
                            <TextBlock x:Name="IsleBL" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       FontSize="11.5" FontWeight="SemiBold" TextWrapping="NoWrap"
                                       Foreground="#FF9A9AA0" />
                            <TextBlock x:Name="IsleBR" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="NoWrap"
                                       Foreground="#FFFFFFFF" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="HeaderButtons" Grid.Column="2" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button x:Name="MinBtn" Style="{StaticResource IconButton}" Width="19" Height="19"
                                Click="Minimize_Click" ToolTip="Minimizo">
                            <Path x:Name="MinIcon" Data="{StaticResource IconMinimize}" Stroke="#FF93A6BE" StrokeThickness="1.7"
                                  Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="19" Height="19" Click="Settings_Click" ToolTip="Cilësimet">
                            <Path x:Name="GearIcon" Data="{StaticResource IconSettings}" Stroke="#FF93A6BE" StrokeThickness="1.7"
                                  Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="19" Height="19" Click="Hide_Click" ToolTip="Fshih (mbetet ne tray)">
                            <Path x:Name="CloseIcon" Data="{StaticResource IconClose}" Stroke="#FF93A6BE" StrokeThickness="1.7"
                                  Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- metrics -->
                <ItemsControl x:Name="RowsHost" ItemTemplate="{StaticResource RowTemplate}"
                              ItemsPanel="{StaticResource VerticalPanel}" />

                <!-- footer -->
                <StackPanel x:Name="FooterRow">
                    <Border x:Name="FooterLine" Height="1" Background="#14FFFFFF" Margin="0,9,0,7" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="FooterMade" Text="Made in Kosovo with" FontSize="8.5"
                                   Foreground="#FF5D6E85" VerticalAlignment="Center" />
                        <Path Data="{StaticResource IconHeart}" Fill="#FFFF4D6A" Width="9" Height="9" Stretch="Uniform"
                              Margin="4,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterSep" Text="|" FontSize="8.5" Foreground="#FF2B3545"
                                   Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SiteLink" Text="Likaapps.com" FontSize="8.5" Cursor="Hand"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                   MouseLeftButtonUp="Site_Click" ToolTip="Hap Likaapps.com" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- drag this to make the whole widget bigger or smaller. Hidden until the
             pointer is on the card, so it never sits in a screenshot. -->
        <Border x:Name="SizeGrip" Width="16" Height="16" Opacity="0"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#01000000" Cursor="SizeNWSE" ToolTip="Tërhiq për ta zmadhuar"
                MouseLeftButtonDown="Grip_Down" MouseMove="Grip_Move"
                MouseLeftButtonUp="Grip_Up">
            <Path Data="{StaticResource IconGrip}" Stretch="Uniform" Width="9" Height="9"
                  Margin="0,0,1,1" Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Border>
    </Grid>
</Window>
